# Guest tier retrieval and RAGAS judge (gpt-4o-mini)
OPENAI_API_KEY=

# Supabase postgres connection string
# Production: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Local dev: postgresql://ragscope:ragscope@localhost:5433/ragscope
SUPABASE_URL=

# Supabase service role key (from Project Settings > API Keys)
SUPABASE_KEY=

# LangSmith API key for tracing (from smith.langchain.com)
LANGCHAIN_API_KEY=

# Enable LangSmith tracing (true in production, false in local dev)
LANGCHAIN_TRACING_V2=false

# LangSmith project name
LANGCHAIN_PROJECT=ragscope

# Private dev bypass token -- never commit a real value here
DEV_TOKEN=

# Maximum combined upload size in bytes (10MB)
MAX_FILE_SIZE_BYTES=10485760